# ============================================
# TaobaoScraper 环境变量配置
# 使用方法：复制本文件为 .env，然后修改下面的值
# ============================================

# API 认证密钥（必改！调用接口时需要在 Header 带上 X-API-Key）
SCRAPER_API_KEY=your-secret-key-here

# Chrome 调试端口（一般不用改）
SCRAPER_CHROME_PORT=9222

# ============================================
# MCP Server 配置（使用 MCP 时需要）
# ============================================

# FastAPI 后端地址（MCP Server 连接目标）
SCRAPER_API_URL=http://localhost:8000

# SSE 模式监听地址和端口
MCP_SSE_HOST=0.0.0.0
MCP_SSE_PORT=8001

# SSE 认证开关（true=启用 Bearer Token 认证，false=关闭）
# 启用后客户端连接 SSE 需要带 Authorization: Bearer <SCRAPER_API_KEY>
MCP_SSE_AUTH=true

# HTTP 请求超时（秒）
MCP_HTTP_TIMEOUT=30
